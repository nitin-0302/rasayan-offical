rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && "email" in request.auth.token && (
          request.auth.token.email == "brothernitin99@gmail.com" || 
          request.auth.token.email == "nitin.c@somaiya.edu" ||
          request.auth.token.email == "meetshetye06@gmail.com"
        )) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         (!get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.keys().contains('role') || 
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    function isCoAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && "email" in request.auth.token && (
          request.auth.token.email == "brothernitin77@gmail.com"
        )) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'co-admin')
      );
    }

    function isAtLeastCoAdmin() {
      return isAdmin() || isCoAdmin();
    }

    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) ||
             (request.auth == null && userId.matches('^guest_local_.*'));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'createdAt']) &&
             (data.userId == (request.auth != null ? request.auth.uid : '') || (request.auth == null && data.userId.matches('^guest_local_.*'))) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('college' in data) || (data.college is string && data.college.size() <= 100)) &&
             (!('isAdmin' in data) || data.isAdmin is bool) &&
             (!('isCoAdmin' in data) || data.isCoAdmin is bool) &&
             data.createdAt is string;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'userName', 'eventIds', 'teamDetails', 'phone', 'college', 'totalAmount', 'paymentMethod', 'transactionId', 'paymentStatus', 'confirmationMessage', 'uniqueCode', 'registrationTime']) &&
             (data.userId == (request.auth != null ? request.auth.uid : '') || (request.auth == null && data.userId.matches('^guest_local_.*'))) &&
             data.userEmail is string &&
             data.userName is string &&
             data.eventIds is list && data.eventIds.size() > 0 &&
             data.teamDetails is map &&
             data.phone is string && data.phone.size() >= 10 &&
             data.college is string &&
             data.totalAmount is number &&
             data.paymentMethod in ['upi', 'cash'] &&
             data.transactionId is string &&
             data.paymentStatus == 'pending' &&
             data.uniqueCode is string && data.uniqueCode.size() >= 5 &&
             data.registrationTime is string;
    }

    function isValidRegUpdate(data) {
      return isAtLeastCoAdmin() || (request.auth != null && (
        (!data.keys().contains('paymentStatus') || data.paymentStatus in ['pending', 'approved', 'rejected', 'confirmed']) &&
        (!data.keys().contains('attended') || data.attended is bool)
      )) || (request.auth == null && data.userId.matches('^guest_local_.*') && (
        (!data.keys().contains('paymentStatus') || data.paymentStatus in ['pending', 'approved', 'rejected', 'confirmed']) &&
        (!data.keys().contains('attended') || data.attended is bool)
      ));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'userName', 'text', 'timestamp']) &&
             (data.userId == (request.auth != null ? request.auth.uid : '') || (request.auth == null && data.userId.matches('^guest_local_.*'))) &&
             data.text is string && data.text.size() > 0;
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll(['message', 'type', 'createdAt']) &&
             data.message is string && data.message.size() > 0;
    }

    function isValidQuizResponse(data) {
      return data.keys().hasAll(['userId', 'score', 'submittedAt']) &&
             (data.userId == (request.auth != null ? request.auth.uid : '') || (request.auth == null && data.userId.matches('^guest_local_.*'))) &&
             data.score is number;
    }

    function isValidTreasureHuntProgress(data) {
      return data.keys().hasAll(['userId', 'currentClueIndex']) &&
             (data.userId == (request.auth != null ? request.auth.uid : '') || (request.auth == null && data.userId.matches('^guest_local_.*')));
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'price']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 &&
             data.category is string &&
             data.description is string &&
             data.price is number;
    }

    function isValidRasagramPost(data) {
      return data.keys().hasAll(['userId', 'userName', 'caption', 'likedBy', 'likesCount', 'comments', 'createdAt']) &&
             data.userId is string &&
             data.userName is string &&
             data.caption is string &&
             data.likedBy is list &&
             data.likesCount is number &&
             data.comments is list &&
             (!('imageUrl' in data) || data.imageUrl is string);
    }

    // --- Match Blocks ---

    // 1. Connection Test
    match /test/connection {
      allow read: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAtLeastCoAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAtLeastCoAdmin();
      allow list: if isAtLeastCoAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.email == resource.data.email
      );
    }

    match /registrations/{registrationId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastCoAdmin())) || 
                   (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
      allow create: if (isSignedIn() || (request.auth == null && request.resource.data.userId.matches('^guest_local_.*'))) && isValidRegistration(request.resource.data);
      allow update: if isAtLeastCoAdmin() || 
                    (isSignedIn() && resource.data.userId == request.auth.uid && isValidRegUpdate(request.resource.data)) ||
                    (request.auth == null && resource.data.userId.matches('^guest_local_.*') && isValidRegUpdate(request.resource.data));
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if (isSignedIn() && isValidMessage(request.resource.data)) || 
                    (request.auth == null && request.resource.data.userId.matches('^guest_local_.*') && isValidMessage(request.resource.data));
      allow update, delete: if isAdmin();
    }

    match /announcements/{broadcastId} {
      allow read: if true;
      allow create, update: if isAtLeastCoAdmin() && isValidBroadcast(request.resource.data);
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update: if isAtLeastCoAdmin();
      allow delete: if isAdmin();
    }

    match /quiz_responses/{responseId} {
      allow read: if isSignedIn() || (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
      allow create: if (isSignedIn() || (request.auth == null && request.resource.data.userId.matches('^guest_local_.*'))) && isValidQuizResponse(request.resource.data);
      allow update: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastCoAdmin())) ||
                    (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
      allow delete: if isAdmin();
    }

    match /treasure_hunts/{huntId} {
      allow read: if true;
      allow create, update: if isAtLeastCoAdmin();
      allow delete: if isAdmin();
    }

    match /treasure_hunt_progress/{userId} {
      allow read: if isSignedIn() || (request.auth == null && userId.matches('^guest_local_.*'));
      allow write: if isOwner(userId) && isValidTreasureHuntProgress(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastCoAdmin())) ||
                   (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
      allow create: if (isSignedIn() && (
        (request.resource.data.userId == request.auth.uid && (request.resource.data.sender == 'user' || request.resource.data.sender == 'ai')) || 
        isAtLeastCoAdmin()
      )) || (request.auth == null && request.resource.data.userId.matches('^guest_local_.*') && (request.resource.data.sender == 'user' || request.resource.data.sender == 'ai'));
      allow update: if (isSignedIn() && (
        (resource.data.userId == request.auth.uid) ||
        isAtLeastCoAdmin()
      )) || (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
      allow delete: if isAdmin();
    }

    match /priority_alerts/{alertId} {
      allow read: if (isSignedIn() && (resource == null || resource.data.recipientUserId == request.auth.uid)) ||
                   (request.auth == null && (resource == null || resource.data.recipientUserId.matches('^guest_local_.*')));
      allow create, update: if isAtLeastCoAdmin();
      allow delete: if isAdmin();
    }

    match /rasagram_posts/{postId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid && isValidRasagramPost(request.resource.data)) ||
                    (request.auth == null && request.resource.data.userId.matches('^guest_local_.*') && isValidRasagramPost(request.resource.data));
      allow update: if (isSignedIn() && isValidRasagramPost(request.resource.data)) ||
                    (request.auth == null && request.resource.data.userId.matches('^guest_local_.*') && isValidRasagramPost(request.resource.data));
      allow delete: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastCoAdmin())) ||
                    (request.auth == null && resource.data.userId.matches('^guest_local_.*'));
    }

    match /community_chat/{messageId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
                    (request.auth == null && request.resource.data.userId.matches('^guest_local_.*'));
      allow update: if (isSignedIn() && (
        (request.resource.data.reported == true && request.resource.data.reportsCount == (resource.data.reportsCount == null ? 1 : resource.data.reportsCount + 1)) ||
        isAtLeastCoAdmin()
      )) || (request.auth == null && (
        (request.resource.data.reported == true && request.resource.data.reportsCount == (resource.data.reportsCount == null ? 1 : resource.data.reportsCount + 1))
      ));
      allow delete: if isAtLeastCoAdmin();
    }
  }
}
